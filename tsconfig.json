{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "api/**/*.ts", "agent-loop/**/*.ts", "security/**/*.ts", "scenarios/**/*.ts", "e2e/**/*.ts"],
  "exclude": ["node_modules", ".work", "scenarios/overlays"]
}
