# alibi-qa configuration. Copy to .env only if you need to override defaults.
# Placeholders only. Do not put real provider keys here: this suite never calls
# paid providers, and the runner refuses to start if a real key is present.

# Path to the Alibi repository under test (read-only; it is cloned, never modified).
ALIBI_QA_REPO=../Alibi

# Commit under test. Defaults to qa.config.json "commit".
ALIBI_QA_COMMIT=669c6c0

# How the disposable clone gets node_modules:
#   copy    - copy-on-write copy of the source repo's node_modules (offline; only
#             allowed when the commit's package-lock.json matches the source's)
#   npm-ci  - `npm ci` in the clone (requires network access to the npm registry)
ALIBI_QA_DEPS=copy

# Workspace for the target clone and per-run data. Must be under $HOME when the
# Docker tier runs on Docker Desktop / Rancher Desktop (bind-mount visibility).
ALIBI_QA_WORK_DIR=.work

# Keep per-run data directories (SQLite, server logs) after the run for debugging.
ALIBI_QA_KEEP=0

# Reserved for a future, explicitly approved live run. The runner currently
# refuses to run when this is set. Leave empty.
ALIBI_QA_ALLOW_PAID_APIS=
